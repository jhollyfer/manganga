# Segredos. O `frontend/.gitignore` cobre o projeto, mas a raiz não cobria nada,
# e um `.env` criado aqui por engano entraria no commit sem ninguém notar.
.env
.env.local

# IDE da JetBrains.
.idea/

node_modules/

# Build solto na raiz. O site é `frontend/`, e o build dele sai em
# `frontend/.output/`, que o `frontend/.gitignore` já cobre.
dist/

# Worktrees dos agentes do Claude Code: cópias locais, nunca versionadas.
.claude/worktrees/
